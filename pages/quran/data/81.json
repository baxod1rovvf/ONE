{
 "n": 81,
 "nameAr": "التكوير",
 "nameUz": "At-Takwir",
 "verses": [
  {
   "n": 1,
   "ar": "إِذَا ٱلشَّمْسُ كُوِّرَتْ",
   "reading": "Izash shamsu kuvvirat.",
   "uz": "Vaqtiki, quyoshni buklab, oʻralsa."
  },
  {
   "n": 2,
   "ar": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
   "reading": "Va izan nujuumun kadarat.",
   "uz": "Va vaqtiki yulduzlar uzilib tushib, sochilib ketsa."
  },
  {
   "n": 3,
   "ar": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
   "reading": "Va izal jibaalu suyyirat.",
   "uz": "Va vaqtiki, togʻlar joyidan koʻchirilsa."
  },
  {
   "n": 4,
   "ar": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
   "reading": "Va izal 'ishaaru 'uttilat.",
   "uz": "Va vaqtiki, homilasiga oʻn oy toʻlgan tuyalar qarovsiz qolsa."
  },
  {
   "n": 5,
   "ar": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
   "reading": "Va izal vuhuushu hushirat.",
   "uz": "Va vaqtiki, vahshiy hayvonlar bir joyga toʻplansa."
  },
  {
   "n": 6,
   "ar": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
   "reading": "Va izal bihaaru sujjirat.",
   "uz": "Va vaqtiki, dengizlar alanga olib yonsa."
  },
  {
   "n": 7,
   "ar": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
   "reading": "Va izan nufuusu zuvvijat.",
   "uz": "Va vaqtiki, nafslar juftlashtirilsa. [1]",
   "notes": "[1] (Yaʼni, ruh tanaga qaytarilib, ikkovlari birlashsalar.)"
  },
  {
   "n": 8,
   "ar": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
   "reading": "Va izal mav'uudatu su'ilat.",
   "uz": "Va vaqtiki, tiriklay koʻmilgan qizdan soʻralsa."
  },
  {
   "n": 9,
   "ar": "بِأَىِّ ذَنۢبٍ قُتِلَتْ",
   "reading": "Bi ayyi zambin qutilat.",
   "uz": "U nima gunoh uchun oʻldirilgan?"
  },
  {
   "n": 10,
   "ar": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
   "reading": "Va izas suhufu nushirat.",
   "uz": "Va vaqtiki, sahifalar nashr qilinsa."
  },
  {
   "n": 11,
   "ar": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
   "reading": "Va izas samaaa'u kushitat.",
   "uz": "Va vaqtiki, osmon qoʻporilsa."
  },
  {
   "n": 12,
   "ar": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
   "reading": "Va izal jahiymu su'-'irat.",
   "uz": "Va vaqtiki, jahannam qizdirilsa."
  },
  {
   "n": 13,
   "ar": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
   "reading": "Va izal jannatu uzlifat.",
   "uz": "Va vaqtiki, jannat yaqinlashtirilsa."
  },
  {
   "n": 14,
   "ar": "عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ",
   "reading": "'Alimat nafsum maaa ahdarat.",
   "uz": "Har bir jon nima hozirlaganini biladir."
  },
  {
   "n": 15,
   "ar": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ",
   "reading": "Falaaa uqsimu bil xunnas.",
   "uz": "(Kunduzi) maxfiy boʻluvchi(yulduz)lar bilan qasam."
  },
  {
   "n": 16,
   "ar": "ٱلْجَوَارِ ٱلْكُنَّسِ",
   "reading": "Al javaaril kunnas.",
   "uz": "(Kechalari) yuruvchi, berkinuvchi(yulduz)lar bilan qasam."
  },
  {
   "n": 17,
   "ar": "وَٱلَّيْلِ إِذَا عَسْعَسَ",
   "reading": "Vallaili izaa 'as'as.",
   "uz": "Qorongʻuligi ila kirib kelgan kecha bilan qasam."
  },
  {
   "n": 18,
   "ar": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ",
   "reading": "Vassubhi izaa tanaffas.",
   "uz": "Nafas olib kirib kelgan tong bilan qasam."
  },
  {
   "n": 19,
   "ar": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ",
   "reading": "Innahuu laqavlu rasuulin kariym.",
   "uz": "Albatta u(Qurʼon) karamli elchining soʻzidir."
  },
  {
   "n": 20,
   "ar": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ",
   "reading": "Ziy quvvatin 'inda zil 'arshi makiyn.",
   "uz": "U quvvatli, arsh Egasi huzurida martabasi oliydir."
  },
  {
   "n": 21,
   "ar": "مُّطَاعٍ ثَمَّ أَمِينٍ",
   "reading": "Mutaa'in samma amiyn.",
   "uz": "Itoat qilingan, omonatlidir."
  },
  {
   "n": 22,
   "ar": "وَمَا صَاحِبُكُم بِمَجْنُونٍ",
   "reading": "Va maa saahibukum bimajnuun.",
   "uz": "Sizning sohibingiz majnun emasdir."
  },
  {
   "n": 23,
   "ar": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ",
   "reading": "Va laqad ra aahu bilufuqil mubiyn.",
   "uz": "Batahqiq, ul ani ochiq-oydin ufqda koʻrdi. [2]",
   "notes": "[2] (Muhammad sollallohu alayhi va sallam Jibroilni ochiq-oydin ufqda oʻz koʻzlari bilan asl yaratilishida koʻrdilar.)"
  },
  {
   "n": 24,
   "ar": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ",
   "reading": "Va maa huva 'alal g'aibi bidaniyn.",
   "uz": "Va u gʻaybga baxil emasdir."
  },
  {
   "n": 25,
   "ar": "وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ",
   "reading": "Va maa huva biqavli shaitaanir rajiym.",
   "uz": "Va u(Qurʼon) toshboʻron qilingan shaytonning soʻzi emasdir."
  },
  {
   "n": 26,
   "ar": "فَأَيْنَ تَذْهَبُونَ",
   "reading": "Fa ayna tazhabuun.",
   "uz": "Bas, qayoqqa ketmoqdasiz?!"
  },
  {
   "n": 27,
   "ar": "إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ",
   "reading": "In huva illaa zikrul lil'aalamiyn.",
   "uz": "U (Qurʼon) olamlarga eslatmadan boshqa narsa emasdir."
  },
  {
   "n": 28,
   "ar": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ",
   "reading": "Liman shaaa'a minkum ai yastaqiym.",
   "uz": "Sizlardan istiqomat(toʻgʻri yoʻl)da boʻlishni xohlovchilar uchundir."
  },
  {
   "n": 29,
   "ar": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ",
   "reading": "Va maa tashaaa'uuna illaaa ai yashaaa 'al laahu Robbul 'Aalamiyn.",
   "uz": "Olamlarning Robbi Alloh xohlamasa, sizlar xohlay olmassizlar. [3]",
   "notes": "[3] (Har bir narsa Allohning xohishiga bogʻliq. Har bir narsa Alloh taoloning xohishi ila boʻladi.)"
  }
 ],
