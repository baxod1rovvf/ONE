   "ar": "إِلَـٰهِ ٱلنَّاسِ",
   "reading": "Ilaahin naas.",
   "uz": "Odamlar Ilohidan panoh soʻrayman..."
  },
  {
   "n": 4,
   "ar": "مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ",
