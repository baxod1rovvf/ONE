  {
   "n": 31,
   "ar": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا",
   "reading": "Axraja minha maa-aha va mar 'aaha.",
   "uz": "Undan suvni, oʻt-oʻlanlarni chiqardi."
  },
  {
   "n": 32,
   "ar": "وَٱلْجِبَالَ أَرْسَىٰهَا",
