{
 "n": 79,
 "nameAr": "النازعات",
 "nameUz": "An-Nazi'at",
 "verses": [
  {
   "n": 1,
   "ar": "وَٱلنَّـٰزِعَـٰتِ غَرْقًا",
   "reading": "Van naazi 'aati g'arqa.",
   "uz": "Shiddat bilan (jonni) sugʻurib oluvchi(farishta)lar bilan qasam."
  },
  {
   "n": 2,
   "ar": "وَٱلنَّـٰشِطَـٰتِ نَشْطًا",
   "reading": "Van naa shi taati nashta.",
   "uz": "Yumshoqlik bilan jon oluvchi(farishta)lar bilan qasam."
  },
  {
   "n": 3,
   "ar": "وَٱلسَّـٰبِحَـٰتِ سَبْحًا",
   "reading": "Vass saabi-haati sabha.",
   "uz": "Suzib yuruvchi(farishta)lar bilan qasam."
  },
  {
   "n": 4,
   "ar": "فَٱلسَّـٰبِقَـٰتِ سَبْقًا",
   "reading": "Fass saabi qaati sabqa.",
   "uz": "Oʻzishda musobaqa qiluvchi(farishta)lar bilan qasam."
  },
  {
   "n": 5,
   "ar": "فَٱلْمُدَبِّرَٰتِ أَمْرًا",
   "reading": "Fal mu dab-bi raati amra.",
   "uz": "Amrning tadbirini qiluvchi(farishta)lar bilan qasam."
  },
  {
   "n": 6,
   "ar": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ",
   "reading": "Yavma tarjufur raajifa.",
   "uz": "Iztirobga tushuvchi iztirobga tushgan kunda."
  },
  {
   "n": 7,
   "ar": "تَتْبَعُهَا ٱلرَّادِفَةُ",
   "reading": "Tatba'u har raadifa.",
   "uz": "Unga ergashuvchi ergashganda."
  },
  {
   "n": 8,
   "ar": "قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ",
   "reading": "Quluubuny-yau maaiziv-vaaji-fa.",
   "uz": "Oʻsha kunda qalblar xavfga toʻladir."
  },
  {
   "n": 9,
   "ar": "أَبْصَـٰرُهَا خَـٰشِعَةٌ",
   "reading": "Absaa ruhaa xashi'ah.",
   "uz": "Ularning koʻzlari qoʻrqinchga toʻladir."
  },
  {
   "n": 10,
   "ar": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ",
   "reading": "Ya quu luuna a-inna lamar duu duuna fil haafirah.",
   "uz": "Ular: «Biz, albatta, ortga qaytarilamizmi?» – derlar."
  },
  {
   "n": 11,
   "ar": "أَءِذَا كُنَّا عِظَـٰمًا نَّخِرَةً",
   "reading": "Aizaa kunna 'izaa man-naxirah.",
   "uz": "«Chirigan suyak boʻlganimizdan keyin ham-a?»"
  },
  {
   "n": 12,
   "ar": "قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ",
   "reading": "Qaalu tilka izan karratun xaasirah.",
   "uz": "Agar shundoq boʻlsa, bu hasratiy qaytish-ku!» – derlar."
  },
  {
   "n": 13,
   "ar": "فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ",
   "reading": "Fa inna ma hiya zajratuv-vaahida.",
   "uz": "Albatta, u(qiyomat) bir qichqiriqdan boshqa narsa emas."
  },
  {
   "n": 14,
   "ar": "فَإِذَا هُم بِٱلسَّاهِرَةِ",
   "reading": "Faizaa hum biss saahirah.",
   "uz": "Koʻribsizki, ular (qiyomat) maydonida turibdir."
  },
  {
   "n": 15,
   "ar": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ",
   "reading": "Hal ataaka hadiysu Musaa.",
   "uz": "Senga Musoning xabari keldimi?"
  },
  {
   "n": 16,
   "ar": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى",
   "reading": "Iz nadaahu Robbuhu bil vaadil-muqad dasi tuva.",
   "uz": "Qachonki Robbisi unga Muqaddas Tuva vodiysida nido qildi."
  },
  {
   "n": 17,
   "ar": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ",
   "reading": "Izhab ilaa fir'auna innahu tag'aa.",
   "uz": "«Firʼavn huzuriga bor, albatta, u tugʻyonga ketdi."
  },
  {
   "n": 18,
   "ar": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ",
   "reading": "Faqul hal laka ilaa-an tazakka.",
   "uz": "Bas unga ayt: «Senda poklanishga (ragʻbat) bormi?"
  },
  {
   "n": 19,
   "ar": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ",
   "reading": "Va ahdi yaka ila Robbika fatax sha.",
   "uz": "Va seni Robbingga hidoyat qilsam, shoyadki (undan) qoʻrqsang», degin»."
  },
  {
   "n": 20,
   "ar": "فَأَرَىٰهُ ٱلْـَٔايَةَ ٱلْكُبْرَىٰ",
   "reading": "Fa araahul-aayatal kubra.",
   "uz": "Va unga ulkan alomatni koʻrsatdi."
  },
  {
   "n": 21,
   "ar": "فَكَذَّبَ وَعَصَىٰ",
   "reading": "Fa kazzaba va asaa.",
   "uz": "Ul uni yolgʻonga chiqardi va osiy boʻldi."
  },
  {
   "n": 22,
   "ar": "ثُمَّ أَدْبَرَ يَسْعَىٰ",
   "reading": "Summa adbara yas'aa.",
   "uz": "Soʻng ortiga oʻgirilib, tezlab ketdi."
  },
  {
   "n": 23,
   "ar": "فَحَشَرَ فَنَادَىٰ",
   "reading": "Fa hashara fanada.",
   "uz": "Keyin (odamlarni) toʻpladi va nido qildi."
  },
  {
   "n": 24,
   "ar": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ",
   "reading": "Faqala ana Robbu kumul-a'laa.",
   "uz": "Va, men sizlarning eng oliy Robbingizman, dedi."
  },
  {
   "n": 25,
   "ar": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ وَٱلْأُولَىٰٓ",
   "reading": "Fa-axa zahul laahu nakalal aaxirati val-uula.",
   "uz": "Bas, Alloh uni avvalgi va oxirgi gunohlari uchun azobga oldi."
  },
  {
   "n": 26,
   "ar": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ",
   "reading": "Inna fiy zaalika la'ibratal limaiy-yaksha.",
   "uz": "Albatta, bunda U zotdan qoʻrqqanlar uchun ibrat bordir."
  },
  {
   "n": 27,
   "ar": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا",
   "reading": "A-antum a shaddu xalqan amis samaa-u banaaha.",
   "uz": "Sizlarni yaratish qiyinmi yoki U zot bino qilgan osmonnimi?"
  },
  {
   "n": 28,
   "ar": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا",
   "reading": "Raf'a sam kaha fasav vaaha.",
   "uz": "Uning shiftini yuqori koʻtardi va bekami-koʻst, mustahkam qilib qoʻydi."
  },
  {
   "n": 29,
   "ar": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا",
