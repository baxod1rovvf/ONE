  {
   "n": 1,
   "ar": "أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ",
   "reading": "Alam nashrah laka sadrak.",
   "uz": "Sening koʻksingni keng qilib qoʻymadikmi?"
  },
  {
   "n": 2,
   "ar": "وَوَضَعْنَا عَنكَ وِزْرَكَ",
   "reading": "Va va d'ana 'anka vizrak.",
   "uz": "Va sening yukingni yengillatmadikmi?"
  },
  {
   "n": 3,
   "ar": "ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ",
   "reading": "Allaziy anqada zahrak.",
   "uz": "Yelkangni bosib turganni?"
  },
  {
   "n": 4,
   "ar": "وَرَفَعْنَا لَكَ ذِكْرَكَ",
   "reading": "Va raf 'ana laka zikrak.",
