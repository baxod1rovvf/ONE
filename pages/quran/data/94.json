  },
  {
   "n": 5,
   "ar": "فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا",
   "reading": "Fa inna ma'al usri yusra.",
   "uz": "Bas, albatta, qiyinchilik bilan osonchilik bordir."
